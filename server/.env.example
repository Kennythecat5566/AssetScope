ASSETSCOPE_API_TOKEN=replace-with-a-long-random-token
ASSETSCOPE_IMPORT_DIR=data/imports
ASSETSCOPE_USD_TO_TWD=32.4

# Optional Shioaji connector. Keep these values only in server/.env.
ASSETSCOPE_SHIOAJI_ENABLED=false
ASSETSCOPE_SHIOAJI_API_KEY=
ASSETSCOPE_SHIOAJI_SECRET_KEY=

# Optional Firstrade API connector.
# Run server/authorize-firstrade-api.cmd first; do not store passwords here.
ASSETSCOPE_FIRSTRADE_API_ENABLED=false
ASSETSCOPE_FIRSTRADE_API_PATH=../firstrade-api-main
ASSETSCOPE_FIRSTRADE_API_TOKEN_FILE=data/raw/firstrade-api/session.json
ASSETSCOPE_FIRSTRADE_API_ACCOUNT=
ASSETSCOPE_FIRSTRADE_API_HISTORY_RANGE=ytd
